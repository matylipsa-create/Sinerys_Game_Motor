; Engine configuration file.
; Sinerys Game Motor - Godot 4.x / .NET 8
; Hybrid: FFT campaign map + Serious Sam portal combat + vehicle bonus stages

config_version=5

[application]

config/name="Sinerys Game Motor"
config/description="Hybrid game motor: FFT-style campaign map, Serious Sam-style portal combat, vehicle bonus stages."
run/main_scene="res://scenes/UI/MainMenu.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalManager="*res://scripts/Core/GlobalManager.cs"
CampaignManager="*res://scripts/Campaign/CampaignManager.cs"
CombatManager="*res://scripts/Combat/CombatManager.cs"
VehicleManager="*res://scripts/Vehicles/VehicleManager.cs"
SceneTransitionManager="*res://scripts/Core/SceneTransitionManager.cs"
JSONSyncManager="*res://scripts/Core/JSONSyncManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

